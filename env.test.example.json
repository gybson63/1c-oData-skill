{
  "profiles": {
    "default": {
      "telegram_token": "DUMMY_NOT_USED",

      "ai_api_key": "OPENAI_API_KEY",
      "ai_base_url": "https://api.openai.com/v1",
      "ai_model": "gpt-4o-mini",
      "ai_rpm": 20,
      "ai_temperature": 0.1,
      "ai_temperature_step2": 0.3,
      "history_max_turns": 10,

      "history": {
        "max_turns": 10,
        "max_messages": 100,
        "trim_to": 60,
        "persist_dir": ".cache/histories"
      },

      "telegram": {
        "message_max_length": 4000
      },

      "odata": {
        "default_top": 20,
        "max_top": 50,
        "request_timeout": 60
      },

      "agents": {
        "odata": {
          "type": "odata",
          "odata_url": "http://host.docker.internal/YourBase/odata/standard.odata",
          "odata_user": "Администратор",
          "odata_password": "пароль",

          "conf_doc": {
            "enabled": false,
            "api_url": "http://host.docker.internal:8050",
            "configuration": "ЗарплатаИУправлениеПерсоналомКОРП",
            "enrich_prompt": true,
            "search_top_k": 5
          },

          "mcp_servers": {
            "odata": {
              "command": "python",
              "args": ["mcp_servers/odata_server.py"],
              "env": {
                "ODATA_URL": "http://host.docker.internal/YourBase/odata/standard.odata",
                "ODATA_USER": "Администратор",
                "ODATA_PASSWORD": "пароль",
                "ODATA_TIMEOUT": "30",
                "ODATA_CONNECT_TIMEOUT": "10"
              }
            }
          }
        }
      },

      "formatter": {
        "enabled": true,
        "formatter_model": "gpt-4o-mini",
        "temperature": 0.2
      },

      "email": {
        "enabled": true,
        "imap_host": "localhost",
        "imap_port": 3143,
        "imap_user": "bot",
        "imap_password": "secret",
        "imap_folder": "INBOX",
        "imap_use_ssl": false,
        "smtp_host": "localhost",
        "smtp_port": 3025,
        "smtp_user": "bot",
        "smtp_password": "secret",
        "smtp_use_ssl": false,
        "smtp_use_tls": false,
        "from_address": "bot@local.test",
        "from_name": "1С OData Bot (test)",
        "poll_interval": 2,
        "allowed_senders": ["tester@local.test"],
        "context_max_chars": 12000,
        "context_message_max_chars": 3000,
        "context_keep_recent": 3,
        "context_keep_first": true,
        "context_middle_summary_chars": 300,
        "inline_max_chars": 8000,
        "inline_preview_chars": 500,
        "attachment_filename": "",
        "attachment_format": "html",
        "max_fetch_records": 30
      }
    }
  }
}

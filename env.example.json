{
  "profiles": {
    "default": {
      "telegram_token": "TELEGRAM_BOT_TOKEN",

      "ai_api_key": "OPENAI_API_KEY",
      "ai_base_url": "https://api.openai.com/v1",
      "ai_model": "gpt-4o-mini",
      "ai_rpm": 20,
      "ai_temperature": 0.1,
      "ai_temperature_step2": 0.3,
      "ai_timeout_retry_count": 2,
      "ai_timeout_retry_delay": 3,

      "history_max_turns": 10,

      "history": {
        "max_turns": 10,
        "max_messages": 100,
        "trim_to": 60,
        "persist_dir": ".cache/histories"
      },

      "telegram": {
        "message_max_length": 4000,
        "connect_timeout": 30,
        "read_timeout": 120,
        "write_timeout": 60,
        "retry_count": 2,
        "retry_delay": 2,
        "polling_restart_delay": 5,
        "proxy_url": null,
        "use_env_proxy": true,
        "base_url": null,
        "base_file_url": null
      },

      "odata": {
        "default_top": 20,
        "max_top": 50,
        "request_timeout": 60,
        "max_url_length": 2000,
        "max_expand_fields": 15,
        "max_sample_records": 30,
        "max_data_length": 8000,
        "metadata_cache_seconds": 86400,
        "max_analytics_records": 500,
        "max_analytics_joins": 3,
        "chart_max_categories": 30
      },

      "mcp_servers": {
        "conf-doc": {
          "transport": "stdio",
          "command": "C:\\ПервыйБИТ\\ИИ\\1c-conf-doc\\.venv\\Scripts\\python.exe",
          "args": ["-m", "onec_conf_doc.mcp"],
          "env": {
            "CONF_DOC_API_URL": "http://localhost:8050",
            "CONF_DOC_CONFIGURATION": "ЗарплатаИУправлениеПерсоналомКОРП"
          }
        }
      },

      "agents": {
        "analyst": {
          "type": "analyst",
          "profile_path": "skills/analyst/profiles/zup-korp.md",
          "mcp_inherit": true,
          "mcp_servers": {
            "web-search": {
              "enabled": false,
              "transport": "stdio",
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-brave-search"],
              "env": {
                "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY"
              }
            },
            "document-reader": {
              "enabled": false,
              "transport": "stdio",
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\books"],
              "env": {}
            }
          },
          "max_tool_iterations": 8,
          "allowed_mcp_tools": [
            "conf_doc_search",
            "conf_doc_get_object",
            "conf_doc_get_object_chunk",
            "conf_doc_list_objects",
            "conf_doc_list_configurations",
            "conf_doc_health"
          ],
          "conf_doc_fallback": {
            "enabled": true,
            "api_url": "http://localhost:8050",
            "configuration": "ЗарплатаИУправлениеПерсоналомКОРП",
            "enrich_prompt": false,
            "search_top_k": 5
          },
          "preprocessor_for_odata": true
        },
        "odata": {
          "type": "odata",
          "odata_url": "http://localhost/YourBaseName/odata/standard.odata",
          "odata_user": "Администратор",
          "odata_password": "пароль",

          "conf_doc": {
            "enabled": true,
            "api_url": "http://localhost:8050",
            "configuration": "ЗарплатаИУправлениеПерсоналомКОРП",
            "enrich_prompt": true,
            "search_top_k": 5
          },

          "mcp_inherit": true,
          "mcp_servers": {
            "odata": {
              "transport": "stdio",
              "command": "python",
              "args": ["mcp_servers/odata_server.py"],
              "env": {
                "ODATA_URL": "http://localhost/YourBaseName/odata/standard.odata",
                "ODATA_USER": "Администратор",
                "ODATA_PASSWORD": "пароль",
                "ODATA_TIMEOUT": "30",
                "ODATA_CONNECT_TIMEOUT": "10"
              }
            }
          }
        }
      },

      "formatter": {
        "enabled": true,
        "formatter_model": "gpt-4o-mini",
        "temperature": 0.2
      },

      "ai_pricing": {
        "input_per_1m": 0.15,
        "output_per_1m": 0.60
      },

      "email": {
        "enabled": false,
        "imap_host": "imap.example.com",
        "imap_port": 993,
        "imap_user": "bot@example.com",
        "imap_password": "password",
        "imap_folder": "INBOX",
        "imap_use_ssl": true,
        "smtp_host": "smtp.example.com",
        "smtp_port": 587,
        "smtp_user": "bot@example.com",
        "smtp_password": "password",
        "smtp_use_ssl": false,
        "smtp_use_tls": true,
        "from_address": "bot@example.com",
        "from_name": "1С OData Bot",
        "poll_interval": 30,
        "allowed_senders": [],
        "context_max_chars": 12000,
        "context_message_max_chars": 3000,
        "context_keep_recent": 3,
        "context_keep_first": true,
        "context_middle_summary_chars": 300,
        "inline_max_chars": 8000,
        "inline_preview_chars": 500,
        "attachment_filename": "",
        "attachment_format": "html",
        "max_fetch_records": 500
      }
    }
  }
}
